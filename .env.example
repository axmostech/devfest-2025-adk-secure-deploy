# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_REGION=us-east1
GOOGLE_CLOUD_LOCATION=us-east1
GOOGLE_CLOUD_STORAGE_BUCKET=your-bucket-name

# Vertex AI Configuration
GOOGLE_GENAI_USE_VERTEXAI=true
VERTEX_AI_MODEL=gemini-2.5-flash
VERTEX_AI_LOCATION=us-east1
VERTEX_AI_MAX_OUTPUT_TOKENS=8192
VERTEX_AI_TEMPERATURE=0.0
VERTEX_AI_TOP_P=0.95

# Agent Configuration
AGENT_DEBUG_MODE=false
AGENT_LOG_LEVEL=INFO

# Cloud Run Configuration (for deployment)
CLOUD_RUN_SERVICE_NAME=academic-research-agent
CLOUD_RUN_REGION=us-east1
CLOUD_RUN_ALLOW_UNAUTHENTICATED=false

# RAG Configuration (Vertex AI RAG Engine)
# Get corpus name from: https://console.cloud.google.com/gen-app-builder/engines
# You can also just provide the corpus ID (e.g., "devfest-adk") and it will be auto-formatted
RAG_CORPUS_NAME=projects/PROJECT_ID/locations/us-east4/ragCorpora/CORPUS_ID
