# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_CLOUD_STORAGE_BUCKET=your-bucket-name

# Vertex AI Configuration
GOOGLE_GENAI_USE_VERTEXAI=true
VERTEX_AI_MODEL=gemini-2.5-pro
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_MAX_OUTPUT_TOKENS=8192
VERTEX_AI_TEMPERATURE=0.0
VERTEX_AI_TOP_P=0.95

# Agent Configuration
AGENT_DEBUG_MODE=false
AGENT_LOG_LEVEL=INFO

# Cloud Run Configuration (for deployment)
CLOUD_RUN_SERVICE_NAME=academic-research-agent
CLOUD_RUN_REGION=us-central1
CLOUD_RUN_ALLOW_UNAUTHENTICATED=false

# RAG Configuration
# Option 1: Vertex AI Search (recommended for production)
# RAG_SEARCH_DATASTORE_ID=your-datastore-id

# Option 2: Vector Search (for custom embeddings)
# RAG_VECTOR_INDEX_ID=your-vector-index-id
# RAG_VECTOR_INDEX_ENDPOINT=your-vector-endpoint-id
# RAG_EMBEDDING_MODEL=text-embedding-004
